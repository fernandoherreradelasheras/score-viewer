                        <label>Tiple 1º</label>
                        <labelAbbr>T. 1</labelAbbr>
                        <clef shape="G" line="2"/>
                     </staffDef>
                     <staffDef n="2" lines="5">
                        <label>Tiple 2º</label>
                        <labelAbbr>T. 2</labelAbbr>
                        <clef shape="G" line="2"/>
