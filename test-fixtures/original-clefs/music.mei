                        <labelAbbr>[A.]</labelAbbr>
                        <clef shape="G" line="2"/>
                     </staffDef>
                     <staffDef n="4" lines="5">
                        <label>Tenor</label>
                        <labelAbbr>Tn.</labelAbbr>
                        <clef xml:id="cjkdud3" shape="G" line="2" dis="8" dis.place="below"/>
