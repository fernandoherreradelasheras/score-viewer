            <score>
               <scoreDef xml:id="sd.initial" midi.bpm="110.0">
                  <pgHead func="first">
                     <rend halign="center" valign="top">
                        <rend type="title" fontsize="x-large">Genil, galán de los ríos</rend>
                        <lb />
                        <rend type="subtitle" fontsize="large">Tono a 4 del manuscrito P-Cug MM-227</rend>
                     </rend>
                  </pgHead>
                  <staffGrp>
                     <staffGrp symbol="bracket">
                        <staffDef n="1" lines="5" meter.sym="common">
                           <label>Tiple 1</label>
                           <labelAbbr>T.1</labelAbbr>
                           <instrDef midi.instrnum="0" />
                           <clef shape="G" line="2" />
                        </staffDef>
                        <staffDef n="2" lines="5" meter.sym="common">
                           <label>Tiple 2</label>
                           <labelAbbr>T.2</labelAbbr>
                           <instrDef midi.instrnum="0" />
                           <clef shape="G" line="2" />
                        </staffDef>
                        <staffDef n="3" lines="5" meter.sym="common">
                           <label>Alto</label>
                           <labelAbbr>A.</labelAbbr>
                           <instrDef midi.instrnum="52" />
                           <clef xml:id="clef-alto" shape="G" line="2" />
                        </staffDef>
                        <staffDef n="4" lines="5" meter.sym="common">
                           <label>Tenor</label>
                           <labelAbbr>Tn.</labelAbbr>
                           <instrDef midi.instrnum="52" />
                           <clef xml:id="clef-tenor" shape="G" line="2" dis="8" dis.place="below" />
                        </staffDef>
                     </staffGrp>
                     <staffDef n="5" lines="5" meter.sym="common">
                        <label>Guion</label>
                        <labelAbbr>G.(c)</labelAbbr>
                        <instrDef midi.instrnum="0" />
                        <clef shape="F" line="4" />
                     </staffDef>
                  </staffGrp>
               </scoreDef>
